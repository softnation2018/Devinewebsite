# Divine Mantra — environment variables.
# Copy to .env.local for development. Never commit real values.
# In production these are set in the hosting dashboard, not in a file.

# ---- Database ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/divine_mantra?sslmode=require"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Divine Mantra"

# ---- Authentication ----
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# ---- Razorpay (test mode first) ----
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# ---- iThink Logistics ----
ITHINK_BASE_URL="https://api.ithinklogistics.com/api_v3"
ITHINK_ACCESS_TOKEN=""
ITHINK_SECRET_KEY=""

# ---- Shiprocket ----
SHIPROCKET_BASE_URL="https://apiv2.shiprocket.in/v1/external"
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# ---- Image storage (Cloudflare R2) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="divine-mantra-media"
R2_PUBLIC_URL="https://media.example.com"

# ---- Transactional email ----
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM="orders@example.com"
SUPPORT_EMAIL="support@example.com"

# ---- Background jobs ----
CRON_SECRET="generate-with-openssl-rand-hex-32"

# ---- First admin account, used once by the seed script ----
ADMIN_SEED_EMAIL="owner@example.com"
